# Copy to `.env` in the repo root. Relative paths are resolved from the repo root.

# development | test | production
APP_ENV=development
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

DATA_DIR=./data
MODELS_DIR=./models
MODELS_CONFIG_PATH=./backend/config/models.yaml
# Empty = sqlite:///<DATA_DIR>/studio.db
DATABASE_URL=

# auto | cuda | cpu
DEVICE=auto
# performance | balanced | low_vram
PERFORMANCE_PROFILE=balanced
# true -> HF_HUB_OFFLINE=1, TRANSFORMERS_OFFLINE=1 (models must already be downloaded)
OFFLINE_MODE=false
HF_HOME=

# Optional local model directories (override repo IDs in backend/config/models.yaml)
FLUX_MODEL_PATH=
VIDEO_MODEL_PATH=
LLM_MODEL_PATH=
TTS_MODEL_PATH=
LIPSYNC_MODEL_PATH=

# Empty = use PATH. Windows example: C:/ffmpeg/bin/ffmpeg.exe
FFMPEG_PATH=
FFPROBE_PATH=

# Placeholder providers for GPU-less UI/backend development. Refused when APP_ENV=production.
ENABLE_FAKE_PROVIDERS=false

# Only needed to download gated models. Never commit a real token.
HF_TOKEN=
