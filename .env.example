# Sunucu yalnızca bu makineden erişilebilir (varsayılan). Ağa açarsanız APP_PASSWORD zorunlu tutun.
HOST=127.0.0.1
PORT=3000
DATA_DIR=./data

# Kanal kimlik bilgilerini şifreleyen anahtar. Boşsa data/secret.key otomatik üretilir.
APP_SECRET=

# Kabul edilen Host başlıkları (virgülle). Loopback'te varsayılan: localhost,127.0.0.1
ALLOWED_HOSTS=

# Opsiyonel HTTP Basic Auth (kullanıcı adı: admin)
APP_PASSWORD=

POLL_INTERVAL_MS=15000
MAX_ATTEMPTS=3
PUBLISH_CONCURRENCY=4
MAX_UPLOAD_MB=8
